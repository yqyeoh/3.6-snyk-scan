# Snyk (https://snyk.io) policy file, patches or ignores known vulnerabilities.
version: v1.25.0
# ignores vulnerabilities until expiry date; change duration by modifying expiry date
ignore:
  SNYK-JS-ZOD-20510278:
    - '*':
        reason: >-
          No fix available in any zod version. Only exploitable through an
          unbounded z.array() schema; the Lambda schema validates a single
          string capped at 50 chars and has no arrays.
        expires: 2026-10-10T00:00:00.000Z
        created: 2026-10-07T00:00:00.000Z
patch: {}
